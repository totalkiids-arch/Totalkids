{
  "extends": "@totalkids/config/tsconfig/nextjs.json",
  "compilerOptions": {
    // Permite que scripts/ importe .ts con extensión (Node los ejecuta sin compilar).
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}

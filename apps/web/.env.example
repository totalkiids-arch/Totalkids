# ─────────────────────────────────────────────────────────────
# apps/web — variables de entorno (copiar a .env.local y completar)
# NUNCA commitear .env.local con valores reales.
#
# Importante: el navegador nunca llama directo a la API. Todas las llamadas
# pasan por rutas de Next.js (src/app/api/*), que usan API_URL en el servidor.
# Las claves de Flow y Brevo viven SOLO en apps/api/.env, nunca aquí.
# Ninguna variable de este archivo debe llevar el prefijo NEXT_PUBLIC_ salvo
# que sea información pública que pueda verse en el bundle del navegador.
# ─────────────────────────────────────────────────────────────

# URL interna de la API Express (solo servidor). Sin barra final.
API_URL=http://localhost:4000

# URL pública del sitio (canonical, enlaces absolutos, emails). Visible en el navegador.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

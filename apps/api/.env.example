# ─────────────────────────────────────────────────────────────
# apps/api — variables de entorno (copiar a .env y completar)
# NUNCA commitear .env con valores reales.
# ─────────────────────────────────────────────────────────────

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto HTTP en el que escucha la API.
PORT=4000

# Nivel de log de pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Conexión a PostgreSQL de desarrollo (docker-compose expone el puerto 5434).
DATABASE_URL=postgresql://totalkids:totalkids@localhost:5434/totalkids_dev?schema=public

# Conexión a PostgreSQL de tests (usada por Vitest y pnpm db:migrate:test).
TEST_DATABASE_URL=postgresql://totalkids:totalkids@localhost:5434/totalkids_test?schema=public

# Orígenes permitidos por CORS, separados por coma. El navegador no llama a la API
# directamente (pasa por Next.js), así que normalmente basta con el origen del sitio.
CORS_ORIGINS=http://localhost:3000

# Valor de Express "trust proxy". La API recibe tráfico a través del servidor Next.js;
# "loopback" confía en X-Forwarded-For cuando Next corre en la misma máquina.
# En producción, usar la IP/subred del proxy o el número de saltos (p. ej. 1).
TRUST_PROXY=loopback

# Límite global de peticiones por IP en /api/v1 (RNF-04): ventana en ms y máximo
# por ventana. Por defecto 300 peticiones cada 5 minutos.
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX=300

# Secreto HMAC de los tokens CSRF (mínimo 32 caracteres). OBLIGATORIO en producción.
# Si se deja vacío en desarrollo, la API genera uno al arrancar (los tokens caducan
# al reiniciar). Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=

# Documentación OpenAPI en /api/docs: enabled | disabled. Por defecto enabled,
# salvo con NODE_ENV=production, donde queda disabled (SRS 4.4.2).
API_DOCS=

# ── Flow (pasarela de pago, LN-10) ──
# Sin claves, la API arranca pero no se pueden iniciar pagos.
# API key del comercio en Flow (sandbox en desarrollo).
FLOW_API_KEY=
# Secret key para firmar las peticiones a Flow.
FLOW_SECRET_KEY=
# URL base de la API de Flow. Producción: https://www.flow.cl/api
FLOW_API_BASE=https://sandbox.flow.cl/api
# URL pública de la API a la que Flow envía la confirmación y el retorno. En local
# hace falta un túnel (Flow no llega a localhost). Con Flow de producción exige https.
FLOW_CALLBACK_BASE=http://localhost:4000/api/v1

# ── Correos transaccionales y worker (LN-14) ──
# Adaptador de envío: fake | brevo. Por defecto fake: no usa la red y deja los
# correos como "enviados" en email_log. En tests siempre se usa fake.
# Brevo solo se usa con EMAIL_PROVIDER=brevo y BREVO_API_KEY.
EMAIL_PROVIDER=fake
# API key de Brevo (solo backend). Obligatoria en producción con Brevo.
BREVO_API_KEY=
# URL de la API transaccional. Vacía = https://api.brevo.com/v3/smtp/email
BREVO_API_URL=
# Remitente autorizado en Brevo. Obligatorio en producción con Brevo; el dominio
# del cliente debe estar autenticado en Brevo (SPF/DKIM/DMARC) antes de producción.
BREVO_SENDER_EMAIL=no-reply@example.com
# Nombre visible del remitente.
BREVO_SENDER_NAME=Total Kids
# Casilla del equipo: "nueva venta" y copia de "solicitud de servicio".
# Obligatoria en producción con Brevo.
EMAIL_ADMIN_TO=equipo@example.com
# Origen público del sitio (Next.js) para los enlaces de los correos.
# Obligatorio en producción y con https.
PUBLIC_SITE_URL=http://localhost:3000
# Timeout de cada envío a Brevo (ms). Sin respuesta = resultado incierto.
EMAIL_SEND_TIMEOUT_MS=10000
# Worker: cada cuánto busca trabajos (ms), cuántos toma por vuelta y cuándo un
# bloqueo se considera de un worker caído (ms; mayor que EMAIL_SEND_TIMEOUT_MS).
EMAIL_WORKER_POLL_MS=5000
EMAIL_WORKER_BATCH=10
EMAIL_WORKER_LOCK_TIMEOUT_MS=300000
# Límite diario de envíos (día de Chile). El plan gratis de Brevo permite 300.
# Al llegar a LIMIT - RESERVE solo salen los correos críticos (pedido recibido,
# compra confirmada, pago rechazado, recuperación, alerta de pago, despacho); al
# llegar al límite se pausa todo hasta mañana y se avisa al equipo una vez.
EMAIL_DAILY_LIMIT=300
EMAIL_DAILY_RESERVE=30
# Contacto de la tienda en el pie de los correos (opcional; vacío = no se muestra).
STORE_CONTACT=

# ── Conciliación y vencimientos (LN-15) ──
# El worker vence los pedidos sin pagar y concilia con Flow los pagos pendientes
# o inciertos. Usa las mismas FLOW_API_KEY y FLOW_SECRET_KEY: sin ellas solo
# vence los pedidos sin pago iniciado, y los pagos abiertos quedan en revisión.
# Cada cuánto corre (ms). Por defecto 2 minutos (SRS D-02).
PAYMENT_JOB_INTERVAL_MS=120000
# Pagos que se concilian y pedidos que se vencen por vuelta.
PAYMENT_JOB_BATCH=20

# ── Imágenes del catálogo (LN-12) ──
# Carpeta donde el adaptador de disco local guarda las fotos subidas desde el
# panel (relativa a apps/api o absoluta). En desarrollo la API la sirve en /uploads.
IMAGES_DIR=uploads
# Base pública de esas imágenes (sin barra final). Vacía en desarrollo =
# http://localhost:4000/uploads. Obligatoria en producción y con https (el proxy
# del VPS sirve IMAGES_DIR; ver README, "Catálogo admin").
IMAGES_PUBLIC_URL=

# ── Carrito (LN-06) ──
# Días sin uso tras los que vence el carrito del invitado (1–90). Cada uso lo
# extiende; el worker borra los vencidos.
CART_TTL_DAYS=30

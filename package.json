{
  "name": "totalkids",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.17.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "start": "pnpm --parallel --filter \"./apps/*\" start",
    "lint": "pnpm -r lint && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @totalkids/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @totalkids/api db:migrate:deploy",
    "db:migrate:test": "pnpm --filter @totalkids/api db:migrate:test",
    "db:seed": "pnpm --filter @totalkids/api db:seed"
  },
  "devDependencies": {
    "@totalkids/config": "workspace:*",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1"
  }
}
